<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Aura.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sobre"
    BackgroundColor="{StaticResource SpaceBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,32" Spacing="24">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="8">
                <Label
                    Text="ABOUT AURA"
                    FontFamily="SpaceMono"
                    FontSize="12"
                    TextColor="{StaticResource Coral}"
                    CharacterSpacing="3" />

                <Label
                    Text="Muito além de uma descoberta."
                    FontFamily="BodoniModa"
                    FontSize="32"
                    TextColor="{StaticResource TextPrimary}"
                    LineBreakMode="WordWrap" />

                <Label
                    Text="Um universo de possibilidades em um só lugar."
                    FontFamily="DMSans"
                    FontSize="15"
                    TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <!-- Apresentação -->
            <Border
                BackgroundColor="{StaticResource Surface}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="O que é o Aura?"
                        FontFamily="BodoniModa"
                        FontSize="25"
                        TextColor="{StaticResource Lavender}" />

                    <Label
                        Text="O Aura é um aplicativo que conecta diferentes formas de descoberta e expressão. A proposta é transformar informações do cotidiano em experiências personalizadas, aproximando o usuário da música, da arte e do mundo ao seu redor."
                        FontFamily="DMSans"
                        FontSize="14"
                        TextColor="{StaticResource TextPrimary}"
                        LineHeight="1.4" />

                    <Label
                        Text="Cada experiência é uma oportunidade de explorar algo novo, descobrir referências e conhecer um pouco mais sobre suas próprias preferências."
                        FontFamily="DMSans"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}"
                        LineHeight="1.4" />

                </VerticalStackLayout>
            </Border>

            <!-- Funcionalidades -->
            <VerticalStackLayout Spacing="16">

                <Label
                    Text="Explore o universo"
                    FontFamily="BodoniModa"
                    FontSize="25"
                    TextColor="{StaticResource TextPrimary}" />

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="01 / Clima"
                            FontFamily="SpaceMono"
                            FontSize="12"
                            TextColor="{StaticResource Mint}" />

                        <Label
                            Text="Consulte as condições meteorológicas de diferentes cidades e descubra informações sobre temperatura, umidade e vento."
                            FontFamily="DMSans"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="02 / Arte"
                            FontFamily="SpaceMono"
                            FontSize="12"
                            TextColor="{StaticResource Coral}" />

                        <Label
                            Text="Explore obras de arte, conheça artistas e descubra diferentes períodos, culturas e estilos artísticos."
                            FontFamily="DMSans"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="03 / Música"
                            FontFamily="SpaceMono"
                            FontSize="12"
                            TextColor="{StaticResource Lavender}" />

                        <Label
                            Text="Pesquise músicas, conheça artistas e escute prévias de faixas disponíveis no catálogo do iTunes."
                            FontFamily="DMSans"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="04 / Humor"
                            FontFamily="SpaceMono"
                            FontSize="12"
                            TextColor="{StaticResource Mint}" />

                        <Label
                            Text="Selecione como você está se sentindo e receba sugestões de músicas e obras de arte relacionadas ao seu momento."
                            FontFamily="DMSans"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="05 / Discovery"
                            FontFamily="SpaceMono"
                            FontSize="12"
                            TextColor="{StaticResource Coral}" />

                        <Label
                            Text="Combine suas preferências musicais e artísticas com as informações do clima para receber uma experiência de descoberta personalizada."
                            FontFamily="DMSans"
                            FontSize="14"
                            TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- APIs -->
            <Border
                BackgroundColor="{StaticResource SurfaceLight}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                Padding="20"
                StrokeShape="RoundRectangle 22">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Por trás do universo"
                        FontFamily="BodoniModa"
                        FontSize="25"
                        TextColor="{StaticResource TextPrimary}" />

                    <Label
                        Text="O Aura utiliza APIs externas para transformar dados em experiências reais e dinâmicas."
                        FontFamily="DMSans"
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}" />

                    <BoxView
                        HeightRequest="1"
                        Color="{StaticResource BorderColor}" />

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="OPEN-METEO"
                            FontFamily="SpaceMonoBold"
                            FontSize="13"
                            TextColor="{StaticResource Mint}" />

                        <Label
                            Text="Fornece dados meteorológicos e informações de localização."
                            FontFamily="DMSans"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="THE MET"
                            FontFamily="SpaceMonoBold"
                            FontSize="13"
                            TextColor="{StaticResource Coral}" />

                        <Label
                            Text="Disponibiliza informações e imagens de obras do acervo do Metropolitan Museum of Art."
                            FontFamily="DMSans"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="iTUNES SEARCH API"
                            FontFamily="SpaceMonoBold"
                            FontSize="13"
                            TextColor="{StaticResource Lavender}" />

                        <Label
                            Text="Permite pesquisar músicas, artistas, álbuns e obter prévias de áudio."
                            FontFamily="DMSans"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Rodapé -->
            <VerticalStackLayout
                Spacing="8"
                Padding="0,12,0,28"
                HorizontalOptions="Center">

                <Label
                    Text="AURA"
                    FontFamily="BodoniModa"
                    FontSize="34"
                    TextColor="{StaticResource Lavender}"
                    HorizontalTextAlignment="Center"
                    CharacterSpacing="5" />

                <Label
                    Text="Seu universo começa aqui."
                    FontFamily="DMSansItalic"
                    FontSize="13"
                    TextColor="{StaticResource TextSecondary}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Explore. Descubra. Sinta."
                    FontFamily="SpaceMono"
                    FontSize="10"
                    TextColor="{StaticResource TextMuted}"
                    HorizontalTextAlignment="Center"
                    Margin="0,8,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

