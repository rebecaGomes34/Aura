<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="Aura.Views.WeatherPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Clima"
    BackgroundColor="{StaticResource SpaceBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="24,35,24,30"
                             Spacing="23">

            <!-- CABEÇALHO -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="3">
                    <Label Text="AURA."
                           FontFamily="BodoniModa"
                           FontSize="35"
                           TextColor="{StaticResource TextPrimary}"/>

                    <Label Text="WEATHER DIMENSION"
                           FontFamily="SpaceMono"
                           FontSize="9"
                           CharacterSpacing="2"
                           TextColor="#83C9E8"/>
                </VerticalStackLayout>

                <Label Grid.Column="1"
                       Text="01 / 04"
                       FontFamily="SpaceMono"
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}"
                       VerticalOptions="Center"/>
            </Grid>

            <!-- INTRODUÇÃO -->
            <VerticalStackLayout Spacing="7">
                <Label Text="O céu por aí."
                       FontFamily="BodoniModaItalic"
                       FontSize="32"
                       TextColor="{StaticResource TextPrimary}"/>

                <Label Text="Descubra as condições climáticas da sua cidade."
                       FontFamily="DMSans"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"/>
            </VerticalStackLayout>

            <!-- PESQUISA -->
            <Border Padding="15"
                    BackgroundColor="#1C2D46"
                    Stroke="#456F91"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18">

                <VerticalStackLayout Spacing="12">

                    <Label Text="ONDE VOCÊ ESTÁ?"
                           FontFamily="SpaceMono"
                           FontSize="10"
                           CharacterSpacing="1"
                           TextColor="#B9E4F2"/>

                    <Entry x:Name="CityEntry"
                           Placeholder="Digite uma cidade..."
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="{StaticResource TextPrimary}"
                           FontFamily="DMSans"
                           FontSize="15"
                           BackgroundColor="Transparent"
                           ReturnType="Search"
                           Completed="OnSearchClicked"/>

                    <Button x:Name="SearchButton"
                            Text="Consultar clima"
                            HeightRequest="48"
                            FontFamily="DMSans"
                            FontSize="14"
                            FontAttributes="Bold"
                            BackgroundColor="#83C9E8"
                            TextColor="#14283E"
                            CornerRadius="24"
                            Clicked="OnSearchClicked"/>

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#83C9E8"/>

                    <Label x:Name="ErrorLabel"
                           IsVisible="False"
                           FontFamily="DMSans"
                           FontSize="12"
                           TextColor="{StaticResource Coral}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- RESULTADO DO CLIMA -->
            <VerticalStackLayout x:Name="WeatherResultLayout"
                                 IsVisible="False"
                                 Spacing="17">

                <Label Text="CONDIÇÕES ATUAIS"
                       FontFamily="SpaceMono"
                       FontSize="10"
                       CharacterSpacing="1.5"
                       TextColor="#B9E4F2"/>

                <!-- TEMPERATURA -->
                <Border Padding="22"
                        BackgroundColor="#203653"
                        Stroke="#527B9C"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24">

                    <VerticalStackLayout Spacing="10">

                        <Label x:Name="CityResultLabel"
                               Text="Cidade"
                               FontFamily="DMSans"
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}"/>

                        <Grid ColumnDefinitions="*,Auto">

                            <Label x:Name="TemperatureLabel"
                                   Text="--°"
                                   FontFamily="BodoniModa"
                                   FontSize="66"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>

                            <Ellipse Grid.Column="1"
                                     WidthRequest="75"
                                     HeightRequest="75"
                                     Fill="#315477"
                                     Stroke="#83C9E8"
                                     StrokeThickness="2"
                                     VerticalOptions="Center"/>
                        </Grid>

                        <Label x:Name="ConditionLabel"
                               Text="Condição climática"
                               FontFamily="BodoniModaItalic"
                               FontSize="24"
                               TextColor="#B9E4F2"/>

                        <Label x:Name="FeelsLikeLabel"
                               Text="Sensação térmica: --°"
                               FontFamily="DMSans"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- OUTRAS INFORMAÇÕES -->
                <Label Text="MAIS INFORMAÇÕES"
                       FontFamily="SpaceMono"
                       FontSize="10"
                       CharacterSpacing="1.5"
                       TextColor="{StaticResource TextMuted}"/>

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border Padding="16"
                            BackgroundColor="#1C2D46"
                            Stroke="#456F91"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="UMIDADE"
                                   FontFamily="SpaceMono"
                                   FontSize="9"
                                   TextColor="#83C9E8"/>

                            <Label x:Name="HumidityLabel"
                                   Text="--%"
                                   FontFamily="BodoniModa"
                                   FontSize="30"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="16"
                            BackgroundColor="#203653"
                            Stroke="#527B9C"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="VENTO"
                                   FontFamily="SpaceMono"
                                   FontSize="9"
                                   TextColor="#B9E4F2"/>

                            <Label x:Name="WindLabel"
                                   Text="-- km/h"
                                   FontFamily="BodoniModa"
                                   FontSize="25"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Dados meteorológicos fornecidos por Open-Meteo."
                       FontFamily="DMSans"
                       FontSize="10"
                       TextColor="{StaticResource TextMuted}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- RODAPÉ -->
            <Label Text="AURA. — WEATHER IS PART OF YOUR STORY."
                   FontFamily="SpaceMono"
                   FontSize="8"
                   CharacterSpacing="1"
                   TextColor="{StaticResource TextMuted}"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
