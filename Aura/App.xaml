<?xml version="1.0" encoding="UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Aura.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- FUNDOS -->
            <Color x:Key="SpaceBackground">#17152F</Color>
            <Color x:Key="Surface">#292039</Color>
            <Color x:Key="SurfaceLight">#37316A</Color>

            <!-- CORES PRINCIPAIS -->
            <Color x:Key="Lavender">#E8A6FF</Color>
            <Color x:Key="Coral">#FF765E</Color>
            <Color x:Key="Mint">#A8F0DC</Color>

            <!-- TEXTOS -->
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#C9BEDB</Color>
            <Color x:Key="TextMuted">#BFB4D7</Color>

            <!-- DETALHES -->
            <Color x:Key="BorderColor">#514565</Color>
            <Color x:Key="White">#FFF3E9</Color>


            <!-- PALETA DA SEÇÃO CLIMA -->
            <Color x:Key="WeatherBlue">#203653</Color>
            <Color x:Key="WeatherSurface">#1C2D46</Color>
            <Color x:Key="WeatherBlueLight">#315477</Color>
            <Color x:Key="WeatherIce">#B9E4F2</Color>
            <Color x:Key="WeatherAccent">#83C9E8</Color>


        </ResourceDictionary>
    </Application.Resources>
</Application>
